# Keep source text in UTF-8 with LF line endings.
* text=auto eol=lf
*.md text working-tree-encoding=UTF-8
*.js text working-tree-encoding=UTF-8
*.mjs text working-tree-encoding=UTF-8
*.json text working-tree-encoding=UTF-8
*.html text working-tree-encoding=UTF-8
*.css text working-tree-encoding=UTF-8
*.java text working-tree-encoding=UTF-8
*.xml text working-tree-encoding=UTF-8
*.gradle text working-tree-encoding=UTF-8
*.properties text working-tree-encoding=UTF-8
*.py text working-tree-encoding=UTF-8
*.ps1 text working-tree-encoding=UTF-8

# Preserve shell compatibility and Windows batch conventions.
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binary artifacts must not be normalized.
*.jar binary
*.apk binary
*.aab binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
